 -- Read at most one extra byte to detect oversized input without allocating it all.
 boundedRead :: Int -> FilePath -> IO ByteString
-boundedRead limit path = withBinaryFile path ReadMode (\handle -> BS.hGet handle (limit + 1))
+boundedRead limit path = withBinaryFile path ReadMode $ \handle -> do
+  size <- hFileSize handle
+  let firstRead = fromIntegral (min (fromIntegral limit + 1) (size + 1))
+      go remaining request chunks = do
+        bytes <- BS.hGet handle request
+        let rest = remaining - BS.length bytes
+            next = bytes : chunks
+        if BS.length bytes < request || rest == 0
+          then pure (BS.concat (reverse next))
+          else go rest (min rest 65536) next
+  go (limit + 1) firstRead []

