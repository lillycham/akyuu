+profile :: String -> ExceptT RepositoryError IO a -> ExceptT RepositoryError IO a
+profile label action = ExceptT $ do
+  thread <- myThreadId
+  before <- getRTSStats
+  start <- getMonotonicTimeNSec
+  result <- runExceptT action
+  end <- getMonotonicTimeNSec
+  after <- getRTSStats
+  BS.hPut stderr (encodeUtf8 (T.pack ("PROFILE\t" <> show thread <> "\t" <> label <> "\t" <> show start <> "\t" <> show end <> "\t" <> show (gc_elapsed_ns after - gc_elapsed_ns before) <> "\t" <> show (allocated_bytes after - allocated_bytes before) <> "\n")))
+  pure result
+
