cabal-version:      3.0
name:               akyuu
version:            0.2.0.0
synopsis:           A content-addressed memory store for AI agents
description:
  Akyuu keeps memories as immutable plain-text files named by their hash,
  with named refs for the current version, a graph of links, a garbage
  collector, text and optional semantic search, and an MCP server. It is
  modelled on Nix.
homepage:           https://github.com/lillycham/akyuu
bug-reports:        https://github.com/lillycham/akyuu/issues
category:           AI, Database
tested-with:        GHC == 9.10.3
license:            MIT
author:             Lilly Cham
maintainer:         me@lillycham.com
copyright:          2026 Lilly Cham
license-file:       LICENSE
build-type:         Simple
extra-source-files: web/index.html
extra-doc-files:    README.md, CHANGELOG.md

common shared
    default-language: GHC2021
    ghc-options:      -Wall -Wprepositive-qualified-module -Wmissing-import-lists

executable akyuu
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5
                    , akyuu

library
    import: shared
    hs-source-dirs: src/
    build-depends: base >= 4 && <5
                 , cryptohash-sha256
                 , base16-bytestring
                 , bytestring
                 , sqlite-simple
                 , text
                 , containers
                 , directory, filepath, time
                 , filelock
                 , transformers
                 , unix
                 , optparse-applicative
                 , aeson
                 , file-embed
                 , http-types
                 , network
                 , process
                 , streaming-commons
                 , wai
                 , warp

    exposed-modules: Akyuu.Id
                   , Akyuu.Fs
                   , Akyuu.Graph
                   , Akyuu.Memory
                   , Akyuu.Store
                   , Akyuu.Refs
                   , Akyuu.Cache
                   , Akyuu.Amend
                   , Akyuu.Check
                   , Akyuu.Compare
                   , Akyuu.Episode
                   , Akyuu.Embed
                   , Akyuu.Fuzzy
                   , Akyuu.Init
                   , Akyuu.Review
                   , Akyuu.SearchEval
                   , Akyuu.Tier
                   , Akyuu.Supersede
                   , Akyuu.GC
                   , Akyuu.Query
                   , Akyuu.Error
                   , Akyuu.Ops
                   , Akyuu.Render
                   , Akyuu.MCP
                   , Akyuu.Seed
                   , Akyuu.Web.Model
                   , Akyuu.Web.Read
                   , Akyuu.Web.Page
                   , Akyuu.Web.Api
                   , Akyuu.Web.Server
                   , Akyuu.CLI
    other-modules:   Paths_akyuu
    autogen-modules: Paths_akyuu

    default-extensions: ImportQualifiedPost
                      , OverloadedStrings

test-suite akyuu-test
    import:           shared
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    other-modules:    CacheTests
                    , FsTests
                    , GCTests
                    , GraphTests
                    , MemoryTests
                    , OpsTests
                    , CLITests
                    , MCPTests
                    , QueryTests
                    , AmendTests
                    , CheckTests
                    , CompareTests
                    , ReviewTests
                    , TierTests
                    , RecallTests
                    , EmbedTests
                    , EpisodeTests
                    , RefsTests
                    , StoreTests
                    , SeedTests
                    , SupersedeTests
                    , WebTests
                    , Support
    build-depends:    base >=4 && <5
                    , akyuu
                    , base16-bytestring
                    , bytestring
                    , containers
                    , directory
                    , filelock
                    , filepath
                    , optparse-applicative
                    , aeson
                    , http-types
                    , wai
                    , sqlite-simple
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
                    , text
                    , time