cabal-version:      3.0
name:               akyuu
version:            0.1.0.0
synopsis:           akyuu
license:            NONE
build-type:         Simple

common shared
    default-language: GHC2021
    ghc-options:      -Wall

executable akyuu
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5
                    , akyuu

library
    import: shared
    hs-source-dirs: src/
    build-depends: base >= 4 && <5
                 , cryptohash-sha256
                 , base16-bytestring
                 , bytestring
                 , sqlite-simple
                 , text
                 , containers
                 , directory, filepath, time
                 , filelock
                 , transformers
                 , unix

    exposed-modules: Akyuu.Id
                   , Akyuu.Fs
                   , Akyuu.Graph
                   , Akyuu.Memory
                   , Akyuu.Store
                   , Akyuu.Refs
                   , Akyuu.Cache

    default-extensions: ImportQualifiedPost
                      , OverloadedStrings

test-suite akyuu-test
    import:           shared
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    other-modules:    CacheTests
                    , FsTests
                    , GraphTests
                    , MemoryTests
                    , RefsTests
                    , StoreTests
                    , Support
    build-depends:    base >=4 && <5
                    , akyuu
                    , base16-bytestring
                    , bytestring
                    , containers
                    , directory
                    , filelock
                    , filepath
                    , sqlite-simple
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
                    , text
                    , time